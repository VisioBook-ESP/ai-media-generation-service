# Service
PORT=8087
ENV=development  # development | production

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_STREAM=visiobook

# ComfyUI (RunPod pod)
COMFYUI_URL=http://localhost:8188

# S3 / MinIO storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=visiobook
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
