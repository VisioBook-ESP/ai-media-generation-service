# Service
PORT=8087
ENV=development
LOG_LEVEL=info

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_STREAM=visiobook

# Storage Service (MinIO proxy)
STORAGE_URL=http://storage-service:8085

# RunPod Serverless
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_IMAGE=your_image_endpoint_id

# Webhook (URL publique de ce service, accessible par RunPod)
WEBHOOK_BASE_URL=https://your-public-url.com
WEBHOOK_SECRET=                                # Laisser vide pour désactiver la validation HMAC
